# Copier en .env (jamais versionné). Valeurs ci-dessous = développement local (Docker).
# Sur OVH, le .env est à la racine du dossier backoffice/ (hors de public/).

# OVH : APP_ENV=production, APP_URL=https://app.itsmadeleine.shop
APP_ENV=local
APP_URL=http://localhost:8080

DB_HOST=mysql
DB_PORT=3306
DB_NAME=backoffice
DB_USER=backoffice
DB_PASSWORD=backoffice

# Secret client : Dev Dashboard → itsmadeleine.app → Paramètres (ou `pnpm shopify app env show`, SHOPIFY_API_SECRET).
SHOPIFY_CLIENT_SECRET=
# Identifiant de la boutique dans l'URL de l'admin (PAS l'ID client de l'app) :
# https://admin.shopify.com/store/<handle>/… → sert au lien de scan (M4).
SHOPIFY_STORE_HANDLE=
PICKUP_TAG=retrait-qr
# 1 : copie brute de chaque livraison dans var/log/deliveries/ (données personnelles).
# Laisser à 1 jusqu'à la fin de M2, puis 0.
DEBUG_DELIVERIES=0

# Transport d'envoi : smtp (défaut ; Mailpit en local) ou phpmail (fonction mail() de l'hébergement).
# OVH : phpmail depuis le 16/11, le SMTP étant refusé depuis l'IP mutualisée de l'hébergement.
MAIL_TRANSPORT=smtp

# Local : Mailpit (interface sur http://localhost:8025).
# OVH : ssl0.ovh.net, 465, smtps, commandes@itsmadeleine.shop.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=commandes@itsmadeleine.shop
MAIL_FROM_NAME="It's Madeleine"
# Adresse de contact affichée dans le mail au client (défaut : commandes@itsmadeleine.shop).
MAIL_CONTACT=commandes@itsmadeleine.shop
# Alertes internes (M7) : un mail groupé par passage du cron, qui liste les nouvelles commandes en error.
# Vide : alertes seulement dans var/log/alerts.log.
ALERT_EMAIL=
# Garde-fou avant la mise en service : si renseigné (adresses séparées par des virgules),
# seuls ces destinataires reçoivent le mail ; les autres commandes restent pending / not_allowlisted.
# OVH : ton adresse jusqu'à la mise en service (M8), puis vide.
MAIL_ALLOWLIST=

# Plafond d'envoi sur 60 minutes glissantes (mails clients + alertes). OVH limite à 200 par heure et par compte.
# Serveur : 60 depuis le 16/11.
MAIL_MAX_PER_HOUR=120
MAX_ATTEMPTS=3
# Purge par le cron (M7) : commandes et scans après RETENTION_MONTHS, mail_log après MAIL_LOG_RETENTION_DAYS.
# 0 désactive la purge concernée.
RETENTION_MONTHS=12
MAIL_LOG_RETENTION_DAYS=30
