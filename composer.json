{
    "name": "itsmadeleine/backoffice",
    "description": "API du QR code de retrait en boutique (Shopify Events, QR, mail)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "chillerlan/php-qrcode": "^6.0",
        "phpmailer/phpmailer": "^7.2",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
